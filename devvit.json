{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "threadscout",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
 "permissions": {
    "reddit": {
      "enable": true
    },
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["www.reddit.com"]
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostSubmit": "/internal/triggers/on-post-submit"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "threadscout_dev"
  },
  "menu": {
    "items": [
      {
        "label": "ThreadScout Dashboard",
        "description": "Open the ThreadScout duplicate review dashboard.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/open-dashboard"
      },
      {
        "label": "View ThreadScout match",
        "description": "Check whether this post has a ThreadScout duplicate match.",
        "forUserType": "moderator",
        "location": ["post"],
        "endpoint": "/internal/menu/view-threadscout-match",
        "postFilter": "none"
      },
      {
        "label": "Open ThreadScout dashboard",
        "description": "Open the ThreadScout dashboard to review this match.",
        "forUserType": "moderator",
        "location": ["post"],
        "endpoint": "/internal/menu/open-threadscout-case",
        "postFilter": "none"
      }
    ]
  },
  "post": {
  "dir": "dist/client",
  "entrypoints": {
    "default": {
      "entry": "dashboard.html",
      "height": "tall"
    }
  }
},

"settings": {
  "global": {
    "openaiApiKey": {
      "type": "string",
      "label": "OpenAI API Key",
      "isSecret": true
    }
  }
}
}